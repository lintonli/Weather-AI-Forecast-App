# Leave blank when the frontend is served by the same Express app as the backend
# (the default for this project's "npm run build && npm start" flow).
# Set to the backend's public URL only if you deploy frontend and backend separately,
# e.g. VITE_API_BASE_URL=https://weather-ai-backend.onrender.com
VITE_API_BASE_URL=

# Dev-only: where the Vite dev server proxies /api requests to. Change only if your
# local backend runs on a different port than 3000.
DEV_API_PROXY_TARGET=http://localhost:3000
