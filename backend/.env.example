WEATHER_AI_API_KEY=wai_your_key_here
PORT=3000

# Only needed if the frontend is deployed on a different origin than this API
# (leave blank for same-origin deployments, e.g. this repo's default build+start flow).
# Comma-separate multiple origins, e.g. https://weather-ai-frontend.netlify.app
CORS_ORIGIN=

# General API rate limiting (applies to all /api routes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
