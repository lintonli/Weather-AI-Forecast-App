WEATHER_AI_API_KEY=wai_your_key_here
PORT=3000

# Required: the frontend's origin(s), comma-separated. Backend and frontend are always
# deployed/run separately, so requests from the frontend are cross-origin.
# Local dev: http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# General API rate limiting (applies to all /api routes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
